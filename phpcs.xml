<?xml version="1.0"?>
<ruleset name="Common ValueObject">
    <description>Coding standard for Common ValueObject library</description>

    <!-- Show progress -->
    <arg value="p"/>
    
    <!-- Use colors -->
    <arg name="colors"/>
    
    <!-- Paths to check -->
    <file>src</file>
    <file>tests</file>
    
    <!-- PSR-12 coding standard -->
    <rule ref="PSR12"/>
    
    <!-- Exclude vendor directory -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
