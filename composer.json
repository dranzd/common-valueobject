{
    "name": "dranzd/common-valueobject",
    "description": "Domain-Driven Design value object library with common implementations and utilities",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dranzd",
            "email": "dranzd@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:dranzd/common-domain-assert.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:dranzd/common-utils.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ramsey/uuid": "^4.7",
        "doctrine/collections": "^2.0",
        "dranzd/common-domain-assert": "dev-master",
        "dranzd/common-utils": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Dranzd\\Common\\Domain\\ValueObject\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dranzd\\Common\\Domain\\ValueObject\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src tests",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
