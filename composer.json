{
    "name": "dranzd/common-valueobject",
    "description": "Domain-Driven Design value object library with common implementations and utilities",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dranzd",
            "email": "dranzd@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dranzd/common-domain-assert.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/dranzd/common-utils.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ramsey/uuid": "^4.7",
        "doctrine/collections": "^2.0",
        "dranzd/common-domain-assert": "^1.0",
        "dranzd/common-utils": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Dranzd\\Common\\Domain\\ValueObject\\": "src/Domain/ValueObject/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dranzd\\Common\\Domain\\ValueObject\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "phpunit --coverage-text",
        "test:coverage-html": "phpunit --coverage-html=coverage/html",
        "test:coverage-clover": "phpunit --coverage-clover=coverage/clover.xml",
        "phpstan": "phpstan analyse src tests",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "quality": [
            "@test",
            "@phpstan",
            "@cs-check"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
